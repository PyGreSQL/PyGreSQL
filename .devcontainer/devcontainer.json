// Dev container for PyGreSQL, see https://containers.dev/implementors/json_reference/
{
	"name": "PyGreSQL",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/workspace",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "/bin/bash"
					}
				},
				"sqltools.connections": [
					{
						"name": "Container database",
						"driver": "PostgreSQL",
						"previewLimit": 50,
						"server": "pg19",
						"port": 5432,
						"database": "test",
						"username": "test",
						"password": "test"
					}
				],
				// The tox env has the C extension built in place (run tox first)
				"python.defaultInterpreterPath": "/workspace/.tox/py315/bin/python",
				"python.analysis.typeCheckingMode": "basic",
				"python.testing.unittestEnabled": true,
				"editor.formatOnSave": true,
				// The code is linted with ruff, but not formatted with it
				"[python]": {
					"editor.formatOnSave": false
				},
				"editor.renderWhitespace": "all",
				"editor.rulers": [
					79
				]
			},
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-python.python",
				"ms-python.mypy-type-checker",
				"ms-vscode.cpptools",
				"mtxr.sqltools",
				"njpwerner.autodocstring",
				"redhat.vscode-yaml",
				"eamodio.gitlens",
				"charliermarsh.ruff",
				"streetsidesoftware.code-spell-checker",
				"lextudio.restructuredtext"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"postCreateCommand": "sudo bash /workspace/.devcontainer/provision.sh"
}
